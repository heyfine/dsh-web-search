# 本插件密钥配置示例（复制为 .env.local 填写；也可通过 DSH 设置卡的「Web 搜索」页在线管理）
# 注意：DSH 部署场景下密钥建议直接存到 DSH 的 settings.yaml 的 web-search-tavily 段，或凭据文件；
# 这里的环境变量仅作为兜底读取源。

# Tavily 搜索（多 key 用 | 分隔）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEYS=

# Keenable 搜索（多 key 用 | 分隔；留空则走免 key 公共端点）
KEENABLE_API_KEY=keen_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KEENABLE_API_KEYS=
