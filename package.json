{
  "name": "@deepseek-ai/dsh-web-search-tavily",
  "description": "DSH Web 搜索插件：Tavily + Keenable 多 key 轮换搜索提供方，附带设置卡（提供方切换 / 密钥管理 / 额度显示）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "check:classic": "node scripts/check-classic.mjs",
    "verify": "node scripts/verify.mjs",
    "sync": "node scripts/sync-repos.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
